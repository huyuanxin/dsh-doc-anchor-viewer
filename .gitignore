# ============================================================
# dsh-doc-anchor-viewer · .gitignore
# ============================================================

# ---- Node / 依赖包 ----
node_modules/
# npm/pnpm/yarn 安装日志（不是 package-lock.json —— 锁文件要提交）
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- 构建产物 ----
# build-docx-preview.mjs 会把 docx-preview 打成 IIFE 注入 lib/client.js 的标记区，
# 产物就落在源文件里（不单独生成 dist）；若以后改成分离构建，dist/build/out 一并忽略。
dist/
build/
out/
*.tsbuildinfo

# ---- 插件运行时数据目录 ----
# store.js 在多候选都不可用时回退到当前目录，于是下面这些会出现在仓库根：
#   doc-anchor-viewer/docs.json   文档索引
#   doc-anchor-viewer/docs/       单篇段落/大纲/标记
#   doc-anchor-viewer/uploads/    用户上传后复制进来的 docx
doc-anchor-viewer/
docs.json

# ---- 文档样本 / 临时文件 ----
# 测试用 docx 是 test/fixtures.mjs 现场构造的，仓库不需要真实样本；
# 真实文档按上面的运行时数据目录存放，不进版本库。
*.docx
*.doc
*.tmp
*.temp
*.bak
*.swp
*.orig
~$*

# ---- 日志 ----
logs/
*.log

# ---- 覆盖率 / 测试产物 ----
coverage/
.nyc_output/

# ---- 缓存 ----
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# ---- 环境变量（含密钥，绝不提交） ----
.env
.env.*
!.env.example

# ---- 操作系统 / 编辑器 ----
.DS_Store
Thumbs.db
desktop.ini
# VS Code 工作区里允许保存的本地片段设置（按需要保留，故注释掉）
# .vscode/
.idea/
*.code-workspace
